# Copy to .env (git-ignored) for a local `docker compose up`, or enter these as environment
# variables in your container manager (Dockhand, Portainer, ...). All are optional.

# Host folder that holds ALL data (default map, one folder per review with its map and PDF).
# Use an absolute path on a server. This is the folder to back up.
DATA_PATH=./data

# Host port the app is published on.
HOST_PORT=8000

# Which host address the port is bound to. 127.0.0.1 = only this machine (safe default). 0.0.0.0 = reachable from your network.
BIND_ADDRESS=127.0.0.1

# User/group id the app runs as; set to your own (`id -u`, `id -g`) so the files in DATA_PATH are yours.
PUID=1000
PGID=1000

# Largest PDF you can attach to a review, in megabytes.
MAX_PDF_MB=100

# Can anyone who reaches the page create an account? true (default) or false.
# The very first account can always be created. Set false once everyone who needs one has signed up.
ALLOW_REGISTRATION=true
